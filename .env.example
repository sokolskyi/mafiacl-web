# Адрес сайта (canonical, sitemap, hreflang)
NEXT_PUBLIC_SITE_URL=https://mafiacl.com

# Supabase → Project Settings → API Keys. В браузер уходит только publishable key.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Только на сервере (Vercel env, без NEXT_PUBLIC_). Никогда не коммитить.
# SUPABASE_SECRET_KEY=
